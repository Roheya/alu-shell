#!/usr/bin/env bash
# Display the PID and process name of processes containing "bash"

for proc in /proc/[0-9]*; do
    pid=$(basename "$proc")
    if [ -r "$proc/comm" ]; then
        name=$(cat "$proc/comm")
        if echo "$name" | grep -q "bash"; then
            echo "$pid $name"
        fi
    fi
done

