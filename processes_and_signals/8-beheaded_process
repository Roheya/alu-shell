#!/usr/bin/env bash
# Kill the process started by 7-highlander

# Send SIGKILL to ensure termination
pkill -9 -f 7-highlander

# Wait until the process is gone
while pgrep -f 7-highlander > /dev/null; do
  sleep 1
done

echo "OK"
