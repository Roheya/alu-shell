#!/usr/bin/env bash
# Script to group Apache log visitors by IP and HTTP status code

file="${1:-access.log}"

# Exit silently if file is missing or empty
[ -s "$file" ] || exit 0

awk '
    # Only process lines that look like proper Apache logs:
    # IP at start, date in field 4, request in field 6, status code in field 9
    $1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ &&
    $4 ~ /^

\[/ &&
    $6 ~ /^"/ &&
    $9 ~ /^[0-9]+$/ {
        print $1, $9
    }
' "$file" \
| awk '{count[$1" "$2]++} END {for (key in count) print count[key], key}' \
| sort -nr

