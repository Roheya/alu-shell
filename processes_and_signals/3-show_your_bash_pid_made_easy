#!/usr/bin/env bash
# Print PID and process name for processes with 'bash' in name, excluding this script

mypid=$$
parentpid=$PPID

for pid in $(pgrep -f bash); do
    if [ "$pid" != "$mypid" ] && [ "$pid" != "$parentpid" ]; then
        # Read process name from /proc, no 'ps' used
        if [ -r "/proc/$pid/comm" ]; then
            name=$(cat /proc/$pid/comm)
            echo "$pid $name"
        fi
    fi
done
