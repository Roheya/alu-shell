#!/usr/bin/env bash
# Script to group Apache log visitors by IP and HTTP status code

file="${1:-access.log}"

# Exit silently if file is missing or empty
[ -s "$file" ] || exit 0

awk '
    # Match only proper Apache log lines:
    # IP at start, then "-", then something, then [date], then "request", then status code
    /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+ .* 

\[[^]]+\]

 "[A-Z]+ [^"]+" [0-9]+/ {
        print $1, $9
    }
' "$file" \
| awk '{count[$1" "$2]++} END {for (key in count) print count[key], key}' \
| sort -nr

