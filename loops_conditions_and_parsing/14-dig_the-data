#!/usr/bin/env bash
# Script to group Apache log visitors by IP and HTTP status code

file="${1:-access.log}"

# Exit silently if file is missing or empty
[ -s "$file" ] || exit 0

awk '
    # Only process lines with a valid IPv4 address and numeric HTTP code
    $1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $9 ~ /^[0-9]+$/ {
        pair = $1 " " $9
        count[pair]++
    }
    END {
        for (pair in count) {
            print count[pair], pair
        }
    }
' "$file" | sort -nr

