#!/usr/bin/env bash
# Script to group Apache log visitors by IP and HTTP status code

# Use the first argument as the log file, default to access.log
file="${1:-access.log}"

# If file doesn’t exist or is empty, exit quietly
[ -s "$file" ] || exit 0

awk '{print $1, $9}' "$file" | \
awk '{count[$1" "$2]++} END {for (key in count) print count[key], key}' | \
sort -nr


