#!/usr/bin/env bash
# Display the PID and process name of processes containing "bash"

for pid in /proc/[0-9]*; do
    pid=$(basename "$pid")
    if [ -f "/proc/$pid/comm" ]; then
        comm=$(cat "/proc/$pid/comm")
        if [[ "$comm" == *"bash"* ]]; then
            echo "$pid $comm"
        fi
    fi
done

